@page "/worker"
@using NaryadAi.Models

<PageTitle>@Language.T("Мои наряды") - НарядAI</PageTitle>

@if (!isAuthorized)
{
    <div class="d-flex justify-center align-center" style="height: 100vh;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="pa-2 pb-16">
        
        @if (currentView == "List")
        {
            <MudText Typo="Typo.h5" Class="mb-4 font-weight-bold">@Language.T("Мои задачи")</MudText>
            <MudButton OnClick="RequestNotificationPermission" Variant="Variant.Outlined" FullWidth="true" Class="mb-4" StartIcon="@Icons.Material.Filled.Notifications">
                @Language.T("Включить уведомления")
            </MudButton>

            @if (!myTasks.Any())
            {
                <div class="empty-state">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Size="Size.Large" Color="Color.Success" />
                    <MudText Typo="Typo.h6" Class="mt-2">@Language.T("Нет активных нарядов")</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Language.T("Мастер пока ничего не назначил.")</MudText>
                </div>
            }
            else
            {
                @foreach (var task in myTasks)
                {
                    bool isEmergency = task.Priority.Contains("Аварийный") || task.Type == "Внеплановый";
                    string cardClass = isEmergency ? "emergency-card mb-4" : "standard-card mb-4";

                    <MudCard Elevation="2" Class="@cardClass">
                        <MudCardHeader Class="pb-2">
                            <CardHeaderContent>
                                <div class="d-flex justify-space-between align-center">
                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">@Language.T("Наряд") @task.Number</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="@(isEmergency ? Color.Error : Color.Primary)" Variant="Variant.Filled">
                                        @Language.T(task.Status)
                                    </MudChip>
                                </div>
                                <MudText Typo="Typo.caption" Color="@(isEmergency ? Color.Error : Color.Secondary)">
                                    @Language.T("Срок до:"): @task.Deadline.ToLocalTime().ToString("HH:mm")
                                </MudText>
                            </CardHeaderContent>
                        </MudCardHeader>

                        <MudCardContent Class="pt-0 pb-2">
                            <div class="info-row"><MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" /> <b>@Language.T("Участок:")</b> @task.Location</div>
                            <div class="info-row"><MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" /> <b>@Language.T("Оборудование:")</b> @task.Equipment?.Name</div>
                            <MudText Typo="Typo.body2" Class="mt-2 task-desc">@task.Description</MudText>
                        </MudCardContent>

                        <MudCardActions Class="d-flex flex-wrap gap-2 pa-3">
                            @if (task.Status == "Выдан")
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Large" Class="flex-grow-1 action-btn" OnClick="@(() => ChangeStatus(task, "Принят в работу"))">@Language.T("ПРИНЯТЬ")</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Large" Class="flex-grow-1 action-btn" OnClick="@(() => ChangeStatus(task, "В очереди"))">@Language.T("В ОЧЕРЕДЬ")</MudButton>
                                <MudButton Variant="Variant.Text" Color="Color.Error" FullWidth="true" Class="mt-2 action-btn" OnClick="@(() => OpenReasonForm(task, "Отклонён"))">@Language.T("Отклонить (с причиной)")</MudButton>
                            }
                            else if (task.Status == "Принят в работу" || task.Status == "В очереди" || task.Status == "Приостановлен" || task.Status == "На доработку")
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" Class="action-btn" OnClick="@(() => ChangeStatus(task, "В работе"))">@Language.T("НАЧАТЬ ИСПОЛНЕНИЕ")</MudButton>
                            }
                            else if (task.Status == "В работе")
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Large" Class="flex-grow-1 action-btn" OnClick="@(() => OpenCloseForm(task))">@Language.T("ИСПОЛНЕНО")</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Large" Class="flex-grow-1 action-btn" OnClick="@(() => OpenReasonForm(task, "Приостановлен"))">@Language.T("ПАУЗА")</MudButton>
                            }
                        </MudCardActions>
                    </MudCard>
                }
            }
        }
        else if (currentView == "Reason")
        {
            <!-- ФОРМА УКАЗАНИЯ ПРИЧИНЫ (Отказ / Пауза) -->
            <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Color="Color.Default" Class="mb-4" OnClick="BackToList">@Language.T("Назад")</MudButton>
            <MudText Typo="Typo.h5" Class="mb-4 font-weight-bold">@(pendingStatus == "Отклонён" ? Language.T("Отказ от наряда") : Language.T("Приостановка работ"))</MudText>
            
            <MudCard Elevation="2" Class="pa-4 rounded-lg">
                <MudText Typo="Typo.body2" Class="mb-4">@Language.T("Укажите причину для наряда") @selectedTask?.Number. @Language.T("Это обязательно по регламенту.")</MudText>
                <MudTextField @bind-Value="actionReason" Label="@Language.T("Причина")" Lines="3" Variant="Variant.Outlined" Class="mb-4" AutoFocus="true" />
                
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" Class="action-btn" OnClick="ConfirmReasonAction">
                    @Language.T("ПОДТВЕРДИТЬ")
                </MudButton>
            </MudCard>
        }
        else if (currentView == "CloseForm")
        {
            <!-- ФОРМА ЗАКРЫТИЯ НАРЯДА (п. 5.3 ТЗ) -->
            <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Color="Color.Default" Class="mb-4" OnClick="BackToList">@Language.T("Назад")</MudButton>
            <MudText Typo="Typo.h5" Class="mb-4 font-weight-bold">@Language.T("Закрытие наряда") @selectedTask?.Number</MudText>

            <MudCard Elevation="2" Class="pa-4 rounded-lg mb-4">
                <MudTextField @bind-Value="selectedTask!.CloseWorksDone" Label="@Language.T("Выполненные работы")" Lines="2" Variant="Variant.Outlined" Class="mb-4" />
                
                <MudSelect T="string" @bind-Value="selectedTask.CloseFaultCode" Label="@Language.T("Шифр неисправности")" Variant="Variant.Outlined" Class="mb-4">
                    @foreach (var fault in faultCodes)
                    {
                        <MudSelectItem T="string" Value="@fault.Name">@fault.Name</MudSelectItem>
                    }
                </MudSelect>

                <MudTextField @bind-Value="selectedTask.CloseComment" Label="@Language.T("Комментарий к выполнению")" Lines="2" Variant="Variant.Outlined" Class="mb-4" />

                <MudText Typo="Typo.subtitle1" Class="mb-2">@Language.T("Списание материалов")</MudText>
                <div class="material-entry mb-2">
                    <MudSelect T="string" @bind-Value="materialName" @bind-Value:after="UpdateMaterialUnit" Label="@Language.T("Материал")" Variant="Variant.Outlined">
                        @foreach (var material in materialItems)
                        {
                            <MudSelectItem T="string" Value="@material.Name">@material.Name (@material.Unit)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudNumericField T="decimal" @bind-Value="materialQuantity" Label="@Language.T("Количество")" Min="0.001m" Variant="Variant.Outlined" />
                    <MudTextField Value="@materialUnit" Label="@Language.T("Единица")" Variant="Variant.Outlined" Disabled="true" />
                </div>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Class="action-btn mb-2" OnClick="AddMaterial">@Language.T("ДОБАВИТЬ МАТЕРИАЛ")</MudButton>
                @foreach (var material in materialDraft)
                {
                    <MudChip T="string" Class="mb-2" OnClose="@(() => RemoveMaterial(material))">@material.Material — @material.Quantity @material.Unit</MudChip>
                }

                <!-- Фото обязательно для внеплановых работ по ТЗ -->
                <div class="photo-upload-zone mb-4">
                    <label class="photo-picker action-btn">
                        <MudIcon Icon="@Icons.Material.Filled.CameraAlt" />
                        @(string.IsNullOrEmpty(selectedTask.PhotoAfterPath) ? Language.T("ВЫБРАТЬ ФОТО ПОСЛЕ") : Language.T("ФОТО СОХРАНЕНО"))
                        <InputFile OnChange="UploadPhoto" accept="image/png,image/jpeg,image/webp" />
                    </label>
                    @if (selectedTask.Type == "Внеплановый")
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">@Language.T("Фото обязательно для аварийных работ")</MudText>
                    }
                </div>

                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Large" FullWidth="true" Class="action-btn" OnClick="ConfirmCloseTask">
                    @Language.T("ОТПРАВИТЬ НА ПРОВЕРКУ")
                </MudButton>
            </MudCard>
        }
    </MudContainer>
}

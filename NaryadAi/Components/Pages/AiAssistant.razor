@page "/ai-assistant"
@implements IDisposable
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedLocalStorage BrowserStorage
@inject NavigationManager Navigation
@using NaryadAi.Services
@using MudBlazor
@inject AiChatbotService ChatbotService
@inject AppLanguageService Language
@inject ISnackbar Snackbar

<PageTitle>@Language.T("ИИ-Ассистент") — НарядAI</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudText Typo="Typo.h5" Class="mb-4 font-weight-bold">@Language.T("ИИ-Ассистент Мастера")</MudText>
    
    <MudPaper Elevation="1" Class="pa-4 d-flex flex-column" Style="height: 60vh; max-height: 600px;">
        <div class="flex-grow-1 overflow-y-auto mb-4 px-2" style="display: flex; flex-direction: column; gap: 12px;">
            @foreach (var msg in messages)
            {
                <div style="display: flex; flex-direction: column; align-items: @(msg.Role == "user" ? "flex-end" : "flex-start");">
                    <MudPaper Elevation="0" Class="@(msg.Role == "user" ? "pa-3 bg-primary text-white rounded-lg" : "pa-3 bg-light rounded-lg")" Style="max-width: 80%;">
                        <MudText Typo="Typo.body1" Style="white-space: pre-wrap;">@msg.Content</MudText>
                    </MudPaper>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">@(msg.Role == "user" ? Language.T("Вы") : Language.T("ИИ-Ассистент"))</MudText>
                </div>
            }
            @if (isTyping)
            {
                <div style="display: flex; flex-direction: column; align-items: flex-start;">
                    <MudPaper Elevation="0" Class="pa-3 bg-light rounded-lg">
                        <MudProgressCircular Color="Color.Default" Size="Size.Small" Indeterminate="true" />
                    </MudPaper>
                </div>
            }
        </div>
        
        <div class="d-flex gap-2">
            <MudTextField @bind-Value="inputMessage" Placeholder="@Language.T("Напишите вопрос (например: Кто сейчас свободен?)")" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" OnKeyDown="HandleKeyDown" />
            <MudIconButton Icon="@Icons.Material.Filled.Send" Color="Color.Primary" Variant="Variant.Filled" OnClick="SendMessageAsync" Disabled="@(isTyping || string.IsNullOrWhiteSpace(inputMessage))" />
        </div>
    </MudPaper>
</MudContainer>


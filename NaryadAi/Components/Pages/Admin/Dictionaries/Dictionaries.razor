@page "/admin/dictionaries"
@using NaryadAi.Models
@using NaryadAi.Data
@using NaryadAi.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedLocalStorage BrowserStorage
@inject NavigationManager Navigation
@inject AppLanguageService Language

<PageTitle>@Language.T("Справочники") - НарядAI</PageTitle>

@if (!isAuthorized)
{
    <div class="d-flex justify-center align-center" style="height: 100vh;">
        <MudProgressCircular Color="Color.Primary"
                             Indeterminate="true"
                             Size="Size.Large" />
    </div>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
        <MudText Typo="Typo.h4"
                 Class="mb-6"
                 Style="font-weight: 700; color: #2c3e50;">
            @Language.T("Управление справочниками")
        </MudText>
        <MudTabs Elevation="2"
                 Rounded="true"
                 ApplyEffectsToContainer="true"
                 PanelClass="pa-6"
                 Color="Color.Primary">
            <MudTabPanel Text="@Language.T("Специальности")"
                         Icon="@Icons.Material.Filled.Work">
                <DictionaryEditor Category="Specialty"
                                  CategoryName="@Language.T("Специальность")" />
            </MudTabPanel>
            <MudTabPanel Text="@Language.T("Смены")"
                         Icon="@Icons.Material.Filled.Schedule">
                <DictionaryEditor Category="Shift"
                                  CategoryName="@Language.T("Смена")" />
            </MudTabPanel>
            <MudTabPanel Text="@Language.T("Участки")"
                         Icon="@Icons.Material.Filled.Factory">
                <SiteEditor />
            </MudTabPanel>
            <MudTabPanel Text="@Language.T("Оборудование")"
                         Icon="@Icons.Material.Filled.PrecisionManufacturing">
                <EquipmentEditor />
            </MudTabPanel>
            <MudTabPanel Text="@Language.T("Шифры неисправностей")"
                         Icon="@Icons.Material.Filled.ReportProblem">
                <DictionaryEditor Category="FaultCode"
                                  CategoryName="@Language.T("Шифр неисправности")" />
            </MudTabPanel>
            <MudTabPanel Text="@Language.T("Материалы")"
                         Icon="@Icons.Material.Filled.Inventory">
                <MaterialEditor />
            </MudTabPanel>
            <MudTabPanel Text="@Language.T("Бригады")"
                         Icon="@Icons.Material.Filled.Groups">

                <DictionaryEditor Category="Brigade"
                                  CategoryName="@Language.T("Бригада")" />
            </MudTabPanel>
        </MudTabs>
    </MudContainer>
}
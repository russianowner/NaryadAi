@using NaryadAi.Models
@using NaryadAi.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject ISnackbar Snackbar

<div class="d-flex align-center gap-2 mb-4 pr-3">
    <MudTextField @bind-Value="newItemName"
                  Label="@($"Новая {CategoryName.ToLower()}")"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Class="flex-grow-1" />

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               DisableElevation="true"
               OnClick="AddItem"
               Size="Size.Small"
               Style="height: 38px; margin-top: 4px; padding: 0 20px; border-radius: 6px;">
        Добавить
    </MudButton>
</div>

<MudTable Items="@items"
          Hover="true"
          Elevation="0"
          Outlined="true"
          Class="rounded-lg"
          RowsPerPage="10"
          RowsPerPageOptions="new int[] { 10, 25, 50 }">
    <HeaderContent>
        <MudTh>Наименование</MudTh>
        <MudTh Style="width: 100px; text-align: center;">Действия</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Наименование">@context.Name</MudTd>
        <MudTd DataLabel="Действия" Style="text-align: center;">
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Class="pa-4 text-muted">Список пуст</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager RowsPerPageString="Строк на странице"
                       PageSizeOptions="new int[] { 10, 25, 50 }" />
    </PagerContent>
</MudTable>

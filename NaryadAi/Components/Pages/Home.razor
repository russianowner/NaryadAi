@page "/"
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedLocalStorage BrowserStorage
@inject NavigationManager Navigation

<PageTitle>НарядAI</PageTitle>

<div class="d-flex justify-center align-center" style="min-height: 50vh; gap: 1rem;">
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
    <MudText>Открываем панель пользователя…</MudText>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var role = await BrowserStorage.GetAsync<string>("UserRole");
        var destination = role.Success ? role.Value switch
        {
            "Master" or "Admin" => "/master",
            "Worker" => "/worker",
            "Manager" => "/dashboard",
            _ => "/login"
        } : "/login";

        Navigation.NavigateTo(destination, replace: true);
    }
}

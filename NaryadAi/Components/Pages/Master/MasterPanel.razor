@page "/master"
@using NaryadAi.Models

<PageTitle>Панель мастера - НарядAI</PageTitle>

@if (!isAuthorized)
{
    <div class="d-flex justify-center align-center" style="height: 100vh;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4 pb-8">
        <MudText Typo="Typo.h5" Class="mb-6 font-weight-bold" Color="Color.Primary">Выдача нового наряда</MudText>

        <MudCard Elevation="3" Class="rounded-lg pa-4">
            <div class="d-flex gap-4 mb-4">
                <MudSelect T="string" @bind-Value="newOrder.Type" Label="Тип работ" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Плановый")">Плановый</MudSelectItem>
                    <MudSelectItem Value="@("Внеплановый")">Внеплановый</MudSelectItem>
                </MudSelect>

                <MudSelect T="string" @bind-Value="newOrder.Priority" Label="Приоритет" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Обычный")">Обычный</MudSelectItem>
                    <MudSelectItem Value="@("Высокий")">Высокий</MudSelectItem>
                    <MudSelectItem Value="@("Аварийный")">Аварийный</MudSelectItem>
                </MudSelect>
            </div>

            <MudTextField @bind-Value="newOrder.Description" Label="Описание проблемы" Lines="3" Variant="Variant.Outlined" Class="mb-4" />

            <!-- Выбор оборудования тянется из базы -->
            <MudSelect T="int" @bind-Value="newOrder.EquipmentId" Label="Оборудование" Variant="Variant.Outlined" Class="mb-4" AnchorOrigin="Origin.BottomCenter">
                @foreach (var eq in equipmentList)
                {
                    <MudSelectItem Value="@eq.Id">@eq.Name (@eq.Location)</MudSelectItem>
                }
            </MudSelect>

            <!-- Выбор только Слесарей из базы -->
            <MudSelect T="int?" @bind-Value="newOrder.ExecutorId" Label="Назначить исполнителя" Variant="Variant.Outlined" Class="mb-4" AnchorOrigin="Origin.BottomCenter">
                @foreach (var w in workers)
                {
                    <MudSelectItem T="int?" Value="@w.Id">
                        <span class="worker-option"><span class="worker-status-dot @WorkerStatusClass(w.Status)"></span>@w.FullName (@w.Specialty) — @w.Status</span>
                    </MudSelectItem>
                }
            </MudSelect>

            <label class="deadline-label" for="deadline">Срок выполнения</label>
            <input id="deadline" class="deadline-input mb-4" type="datetime-local" @bind="deadlineLocal" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" OnClick="CreateOrder" Class="master-action-btn">
                ВЫДАТЬ НАРЯД
            </MudButton>
        </MudCard>

        <section class="orders-board mt-6">
            <div class="board-heading">
                <div>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">Наряды</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Обновите список кнопкой фильтра или перезагрузкой страницы</MudText>
                </div>
                <MudSelect T="string" @bind-Value="selectedStatus" Label="Фильтр по статусу" Variant="Variant.Outlined" Class="board-filter">
                    <MudSelectItem Value="Все">Все статусы</MudSelectItem>
                    @foreach (var status in boardStatuses)
                    {
                        <MudSelectItem Value="@status">@status</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <div class="board-columns">
                @foreach (var lane in boardLanes)
                {
                    var laneOrders = FilteredOrders.Where(x => lane.Statuses.Contains(x.Status)).ToList();
                    <section class="board-lane">
                        <header><strong>@lane.Title</strong><span>@laneOrders.Count</span></header>
                        @foreach (var order in laneOrders)
                        {
                            <article class="board-order">
                                <div class="board-order-top">
                                    <strong>@order.Number</strong>
                                    <span class="board-status" style="--status-color:@StatusColor(order.Status)">@order.Status</span>
                                </div>
                                <div class="board-order-equipment">@(order.Equipment?.Name ?? "Оборудование") · @order.Location</div>
                                <div class="board-order-description">@order.Description</div>
                                <div class="board-order-meta">Исполнитель: @(order.Executor?.FullName ?? "не назначен")</div>
                                <div class="board-order-meta">Срок: @order.Deadline.ToLocalTime().ToString("dd.MM HH:mm")</div>
                                @if (order.Status is "Проверка ИИ" or "На доработку")
                                {
                                    var evaluation = order.AiEvaluations.OrderByDescending(x => x.EvaluatedAt).FirstOrDefault();
                                    <div class="ai-review-box">
                                        <strong>ИИ: @(evaluation?.Verdict ?? "проверка") · @(evaluation?.Score.ToString("0") ?? "—")/100</strong>
                                        <span>@(evaluation?.Explanation ?? "Оценка готовится")</span>
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Class="master-action-btn mt-2" OnClick="@(() => ApproveOrder(order))">ПРИНЯТЬ И ЗАКРЫТЬ</MudButton>
                                        @if (order.Status == "Проверка ИИ")
                                        {
                                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" FullWidth="true" Class="master-action-btn mt-2" OnClick="@(() => ReturnForRework(order))">ВЕРНУТЬ НА ДОРАБОТКУ</MudButton>
                                        }
                                    </div>
                                }
                            </article>
                        }
                        @if (laneOrders.Count == 0)
                        {
                            <div class="board-empty">Нарядов нет</div>
                        }
                    </section>
                }
            </div>
        </section>
    </MudContainer>
}

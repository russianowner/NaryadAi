@page "/master"
@using NaryadAi.Models

<PageTitle>@Language.T("Панель мастера") - НарядAI</PageTitle>

@if (!isAuthorized)
{
    <div class="d-flex justify-center align-center" style="height: 100vh;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="master-page mt-4 pb-8">
        <MudText Typo="Typo.h5"
                 Class="mb-6 font-weight-bold"
                 Color="Color.Primary">
            @Language.T("Выдача нового наряда")
        </MudText>

        <MudCard Elevation="3" Class="rounded-lg pa-4">
            <div class="d-flex gap-4 mb-4">
                <MudSelect T="string" @bind-Value="newOrder.Type" Label="@Language.T("Тип работ")" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Плановый")">@Language.T("Плановый")</MudSelectItem>
                    <MudSelectItem Value="@("Внеплановый")">@Language.T("Внеплановый")</MudSelectItem>
                </MudSelect>

                <MudSelect T="string" @bind-Value="newOrder.Priority" Label="@Language.T("Приоритет")" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Обычный")">@Language.T("Обычный")</MudSelectItem>
                    <MudSelectItem Value="@("Высокий")">@Language.T("Высокий")</MudSelectItem>
                    <MudSelectItem Value="@("Аварийный")">@Language.T("Аварийный")</MudSelectItem>
                    <MudSelectItem Value="@("Плановый")">@Language.T("Плановый")</MudSelectItem>
                </MudSelect>
            </div>

            <div class="d-flex align-start gap-2 mb-4">
                <MudTextField @bind-Value="newOrder.Description" Label="@Language.T("Описание проблемы")" Lines="3" Variant="Variant.Outlined" Class="flex-grow-1" />
                <div class="d-flex flex-column gap-2 mt-2">
                    <MudIconButton Icon="@Icons.Material.Filled.Mic" Color="Color.Primary" Variant="Variant.Filled" OnClick="StartVoiceInput" title="@Language.T("Голосовой ввод")" />    
                    <MudFileUpload T="IBrowserFile" Accept=".png, .jpg, .jpeg" OnFilesChanged="UploadPhotoBefore">
                        <ActivatorContent>
                            <MudIconButton Icon="@Icons.Material.Filled.CameraAlt" Color="@(photoBefore != null ? Color.Success : Color.Secondary)" Variant="Variant.Filled" title="@Language.T("Фото до начала работ")" />
                        </ActivatorContent>
                    </MudFileUpload>
                </div>
            </div>
            <div class="d-flex align-start gap-2 mb-4">
                <div class="flex-grow-1">
                    <MudSelect T="int?"
                               Value="@selectedSiteId"
                               ValueChanged="OnSiteSelected"
                               Label="@Language.T("Участок")"
                               Variant="Variant.Outlined"
                               Class="mb-3">
                        <MudSelectItem T="int?" Value="@((int?)null)">
                            @Language.T("Выберите участок")
                        </MudSelectItem>
                        @foreach (var site in siteList)
                        {
                            <MudSelectItem T="int?" Value="@site.Id">
                                @site.Name
                            </MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="int?"
                               Value="@selectedEquipmentId"
                               ValueChanged="OnEquipmentSelected"
                               Label="@Language.T("Оборудование")"
                               Variant="Variant.Outlined"
                               Disabled="@(!selectedSiteId.HasValue)"
                               HelperText="@(
                               !selectedSiteId.HasValue
                                   ? Language.T("Сначала выберите участок")
                                   : filteredEquipmentList.Count == 0
                                       ? Language.T("На участке нет оборудования")
                                       : null)">
                        <MudSelectItem T="int?" Value="@((int?)null)">
                            @Language.T("Выберите оборудование")
                        </MudSelectItem>
                        @foreach (var eq in filteredEquipmentList)
                        {
                            <MudSelectItem T="int?" Value="@eq.Id">
                                @eq.Name
                            </MudSelectItem>
                        }
                    </MudSelect>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.QrCodeScanner"
                               Color="Color.Secondary"
                               Variant="Variant.Filled"
                               OnClick="ScanQrCode"
                               title="@Language.T("Сканировать QR")"
                               Class="mt-2" />
            </div>
            <MudSelect T="int?" @bind-Value="newOrder.ExecutorId" Label="@Language.T("Назначить исполнителя")" Variant="Variant.Outlined" Class="mb-4" AnchorOrigin="Origin.BottomCenter">
                @foreach (var w in workers)
                {
                    <MudSelectItem T="int?" Value="@w.Id">
                        <span class="worker-option">
                            <span class="worker-status-dot @WorkerStatusClass(w.Status)"></span>
                            @w.FullName (@Language.T(w.Specialty)) — @Language.T(w.Status)
                            @if (recommendedWorkerId == w.Id)
                            {
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="Color.Warning"
                                         Variant="Variant.Text"
                                         Icon="@Icons.Material.Filled.AutoAwesome"
                                         Class="ml-2">
                                    @Language.T("ИИ Рекомендует")
                                </MudChip>
                            }
                        </span>
                    </MudSelectItem>
                }
            </MudSelect>

            <label class="deadline-label" for="deadline">@Language.T("Срок выполнения")</label>
            <input id="deadline" class="deadline-input mb-4" type="datetime-local" @bind="deadlineLocal" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" OnClick="CreateOrder" Class="master-action-btn">
                @Language.T("ВЫДАТЬ НАРЯД")
            </MudButton>
        </MudCard>

        <section class="orders-board mt-6">
            <MudGrid Class="mb-4">
                <MudItem xs="6" sm="3"><MudPaper Class="pa-3 text-center border-left-primary"><div><MudText Typo="Typo.caption" Color="Color.Secondary">@Language.T("Выдано за смену")</MudText></div><MudText Typo="Typo.h5" Class="font-weight-bold">@MasterIssued</MudText></MudPaper></MudItem>
                <MudItem xs="6" sm="3"><MudPaper Class="pa-3 text-center border-left-success"><div><MudText Typo="Typo.caption" Color="Color.Secondary">@Language.T("Исполнено")</MudText></div><MudText Typo="Typo.h5" Class="font-weight-bold">@MasterCompleted</MudText></MudPaper></MudItem>
                <MudItem xs="6" sm="3"><MudPaper Class="pa-3 text-center border-left-error"><div><MudText Typo="Typo.caption" Color="Color.Secondary">@Language.T("Просрочено")</MudText></div><MudText Typo="Typo.h5" Class="font-weight-bold text-error">@MasterOverdue</MudText></MudPaper></MudItem>
                <MudItem xs="6" sm="3"><MudPaper Class="pa-3 text-center border-left-warning"><div><MudText Typo="Typo.caption" Color="Color.Secondary">@Language.T("В простое (шт)")</MudText></div><MudText Typo="Typo.h5" Class="font-weight-bold text-warning">@MasterIdle</MudText></MudPaper></MudItem>
            </MudGrid>
            <div class="board-toolbar mb-4">
                <div class="board-toolbar-title">
                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                        @Language.T("Канбан смены")
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @Language.T("Управление нарядами текущей смены")
                    </MudText>
                </div>
                <div class="board-filter-panel">
                    <div class="board-filter-item">
                        <MudSelect T="string"
                                   @bind-Value="selectedStatus"
                                   Label="@Language.T("Статус")"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="board-filter">
                            <MudSelectItem Value="@("Все")">
                                @Language.T("Все статусы")
                            </MudSelectItem>
                            @foreach (var status in boardStatuses)
                            {
                                <MudSelectItem Value="@status">
                                    @Language.T(status)
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                    <div class="board-filter-item">
                        <MudSelect T="int?"
                                   @bind-Value="filterExecutor"
                                   Label="@Language.T("Исполнитель")"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="true"
                                   Class="board-filter">
                            @foreach (var w in workers)
                            {
                                <MudSelectItem T="int?" Value="@w.Id">
                                    @w.FullName
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                    <div class="board-filter-item">
                        <MudSelect T="string"
                                   @bind-Value="filterPriority"
                                   Label="@Language.T("Приоритет")"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="true"
                                   Class="board-filter">
                            @foreach (var p in priorities)
                            {
                                <MudSelectItem T="string" Value="@p">
                                    @Language.T(p)
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                </div>
            </div>

            <div class="board-columns">
                @foreach (var lane in boardLanes)
                {
                    var laneKey = string.Join("|", lane.Statuses);
                    var laneOrders = FilteredOrders
                        .Where(x => lane.Statuses.Contains(x.Status))
                        .ToList();

                    var lanePageCount = GetLanePageCount(laneOrders.Count);
                    var lanePage = GetLanePage(laneKey, laneOrders.Count);

                    var lanePageOrders = laneOrders
                        .Skip((lanePage - 1) * OrdersPerLanePage)
                        .Take(OrdersPerLanePage)
                        .ToList();

                    <section class="board-lane">

                        <header>
                            <div class="board-lane-title">
                                <strong>@Language.T(lane.Title)</strong>
                            </div>

                            <span>@laneOrders.Count</span>
                        </header>

                        @foreach (var order in lanePageOrders)
                        {
                            <article class="board-order">

                                <div class="board-order-header">

                                    <div class="board-order-number">
                                        <strong>@order.Number</strong>

                                        <span class="board-status"
                                              style="--status-color:@StatusColor(order.Status)">
                                            @Language.T(order.Status)
                                        </span>
                                    </div>

                                </div>

                                <div class="board-order-main">

                                    <div class="board-order-equipment">
                                        @(order.Equipment?.Name ?? Language.T("Оборудование"))
                                    </div>

                                    <div class="board-order-location">
                                        @order.Location
                                    </div>

                                    <div class="board-order-description">
                                        @order.Description
                                    </div>

                                </div>

                                <div class="board-order-info">

                                    <div class="board-info-item">
                                        <span>@Language.T("Исполнитель")</span>
                                        <strong>
                                            @(order.Executor?.FullName ?? Language.T("Не назначен"))
                                        </strong>
                                    </div>

                                    <div class="board-info-item">
                                        <span>@Language.T("Срок")</span>
                                        <strong>
                                            @order.Deadline.ToLocalTime().ToString("dd.MM HH:mm")
                                        </strong>
                                    </div>

                                </div>

                                <div class="order-actions-grid">

                                    @if (order.Status is "Выдан"
                                        or "Принят в работу"
                                        or "В очереди"
                                        or "Приостановлен"
                                        or "На доработку"
                                        or "Отклонён")
                                    {
                                        <div class="order-action-card">

                                            <div class="order-action-header">

                                                <div class="order-action-icon">
                                                    <MudIcon Icon="@Icons.Material.Filled.Group"
                                                             Size="Size.Small" />
                                                </div>

                                                <div class="order-action-title">
                                                    <strong>
                                                        @Language.T("Сменить исполнителя")
                                                    </strong>

                                                    <span>
                                                        @Language.T("Текущий"):
                                                        @(order.Executor?.FullName ?? Language.T("не назначен"))
                                                    </span>
                                                </div>

                                            </div>

                                            <MudSelect T="int?"
                                                       Value="@GetReassignTarget(order.Id)"
                                                       ValueChanged="@(v => reassignTargets[order.Id] = v)"
                                                       Label="@Language.T("Новый исполнитель")"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       FullWidth="true">

                                                @foreach (var w in workers.Where(w => w.Id != order.ExecutorId))
                                                {
                                                    <MudSelectItem T="int?" Value="@w.Id">

                                                        <div class="worker-select-row">

                                                            <span class="worker-status-dot @WorkerStatusClass(w.Status)"></span>

                                                            <span class="worker-select-name">
                                                                @w.FullName
                                                            </span>

                                                            <span class="order-select-status">
                                                                @Language.T(w.Status)
                                                            </span>

                                                        </div>

                                                    </MudSelectItem>
                                                }

                                            </MudSelect>

                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Primary"
                                                       FullWidth="true"
                                                       Size="Size.Small"
                                                       Class="order-action-button"
                                                       Disabled="@(GetReassignTarget(order.Id) is null)"
                                                       OnClick="@(() => ReassignOrder(order))">

                                                <MudIcon Icon="@Icons.Material.Filled.PersonAdd"
                                                         Size="Size.Small"
                                                         Class="mr-2" />

                                                @Language.T("ПЕРЕНАЗНАЧИТЬ")
                                            </MudButton>

                                        </div>
                                    }

                                    @if (order.Status is not ("Закрыт" or "Проверка ИИ" or "Отклонён"))
                                    {
                                        <div class="order-action-card">

                                            <div class="order-action-header">

                                                <div class="order-action-icon priority">
                                                    <MudIcon Icon="@Icons.Material.Filled.Flag"
                                                             Size="Size.Small" />
                                                </div>

                                                <div class="order-action-title">
                                                    <strong>
                                                        @Language.T("Изменить приоритет")
                                                    </strong>

                                                    <span>
                                                        @Language.T("Текущий"):
                                                        @Language.T(order.Priority)
                                                    </span>
                                                </div>

                                            </div>

                                            <MudSelect T="string"
                                                       Value="@(priorityTargets.GetValueOrDefault(order.Id) ?? order.Priority)"
                                                       ValueChanged="@(v => priorityTargets[order.Id] = v)"
                                                       Label="@Language.T("Новый приоритет")"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       FullWidth="true">

                                                @foreach (var p in priorities)
                                                {
                                                    <MudSelectItem T="string" Value="@p">
                                                        @Language.T(p)
                                                    </MudSelectItem>
                                                }

                                            </MudSelect>

                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       FullWidth="true"
                                                       Size="Size.Small"
                                                       Class="order-action-button"
                                                       Disabled="@(priorityTargets.GetValueOrDefault(order.Id) is null ||
                                                                                       priorityTargets.GetValueOrDefault(order.Id) == order.Priority)"
                                                       OnClick="@(() => ChangePriority(order))">

                                                <MudIcon Icon="@Icons.Material.Filled.Flag"
                                                         Size="Size.Small"
                                                         Class="mr-2" />

                                                @Language.T("СМЕНИТЬ ПРИОРИТЕТ")
                                            </MudButton>

                                        </div>
                                    }

                                </div>

                                @if (order.Status is "Проверка ИИ" or "На доработку")
                                {
                                    var evaluation = order.AiEvaluations
                                        .OrderByDescending(x => x.EvaluatedAt)
                                        .FirstOrDefault();

                                    <div class="ai-review-box">

                                        <div class="ai-review-title">
                                            <strong>
                                                @Language.T("ИИ")
                                            </strong>

                                            <span class="ai-score">
                                                @(evaluation?.Score.ToString("0") ?? "—")/100
                                            </span>

                                            <span class="ai-verdict">
                                                @Language.T(evaluation?.Verdict ?? "проверка")
                                            </span>
                                        </div>

                                        <div class="ai-review-text">
                                            @(evaluation?.Explanation ?? Language.T("Оценка готовится"))
                                        </div>

                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Success"
                                                   FullWidth="true"
                                                   Class="master-action-btn mt-2"
                                                   OnClick="@(() => ApproveOrder(order))">
                                            @Language.T("ПРИНЯТЬ И ЗАКРЫТЬ")
                                        </MudButton>

                                        @if (order.Status == "Проверка ИИ")
                                        {
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Warning"
                                                       FullWidth="true"
                                                       Class="master-action-btn mt-2"
                                                       OnClick="@(() => ReturnForRework(order))">
                                                @Language.T("ВЕРНУТЬ НА ДОРАБОТКУ")
                                            </MudButton>
                                        }

                                    </div>
                                }

                            </article>
                        }
                        @if (laneOrders.Count == 0)
                        {
                            <div class="board-empty">
                                @Language.T("Нарядов нет")
                            </div>
                        }
                        else if (lanePageCount > 1)
                        {
                            <div class="lane-pagination">
                                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                               Size="Size.Small"
                                               Disabled="@(lanePage <= 1)"
                                               OnClick="@(() => SetLanePage(laneKey, lanePage - 1))" />
                                <span class="lane-page-info">
                                    @lanePage / @lanePageCount
                                </span>
                                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                               Size="Size.Small"
                                               Disabled="@(lanePage >= lanePageCount)"
                                               OnClick="@(() => SetLanePage(laneKey, lanePage + 1))" />
                            </div>
                        }
                    </section>
                }
            </div>
        </section>
        @if (isQrCameraOpen)
        {
            <div class="qr-scanner-overlay">
                <div class="qr-scanner-modal">
                    <div class="qr-scanner-header">
                        <MudText Typo="Typo.h6" Class="font-weight-bold">
                            @Language.T("Сканирование QR-кода")
                        </MudText>

                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Color="Color.Default"
                                       OnClick="CloseQrCamera" />
                    </div>

                    <div class="qr-camera-frame">
                        <video id="qrCameraPreview"
                               autoplay
                               playsinline
                               muted>
                        </video>

                        <div class="qr-camera-corners"></div>

                        <MudText Class="qr-camera-hint">
                            @Language.T("Наведите камеру на QR-код оборудования")
                        </MudText>
                    </div>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               OnClick="CloseQrCamera"
                               Class="mt-3">
                        @Language.T("Закрыть")
                    </MudButton>
                </div>
            </div>
        }
    </MudContainer>
}

@inherits LayoutComponentBase
@using NaryadAi.Services
@inject AppLanguageService Language

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Color="Color.Primary" Fixed="true" Elevation="2">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudSpacer />
        <MudText Typo="Typo.h6">НарядAI</MudText>
        <MudSpacer />

        <MudIconButton OnClick="ToggleLanguage" Class="pa-0 ml-1 mr-3" Title="Сменить язык">
            <MudAvatar Color="Color.Surface" Variant="Variant.Filled" Size="Size.Small">
                <MudText Typo="Typo.button" Style="font-weight:bold; color: #1976d2">@Language.Current</MudText>
            </MudAvatar>
        </MudIconButton>

        <MudIconButton Href="/profile" Class="pa-0">
            <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Medium">АЕ</MudAvatar>
        </MudIconButton>
    </MudAppBar>

    <MudDrawer @bind-Open="@_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always">
        <MudDrawerHeader Class="pa-4" Style="background-color: #1976d2; color: white;">
            <MudText Typo="Typo.h6">Меню</MudText>
        </MudDrawerHeader>
        <MudNavMenu Class="pt-2">
            <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Analytics">Дашборд ТОиР</MudNavLink>
            <MudNavLink Href="/master" Icon="@Icons.Material.Filled.Dashboard">Панель мастера</MudNavLink>
            <MudNavLink Href="/worker" Icon="@Icons.Material.Filled.ListAlt">Мои наряды</MudNavLink>
            <MudNavLink Href="/reports" Icon="@Icons.Material.Filled.Assessment">Отчёты</MudNavLink>
            <MudNavLink Href="/profile" Icon="@Icons.Material.Filled.Person">Профиль</MudNavLink>
            <MudNavLink Href="/ai-assistant" Icon="@Icons.Material.Filled.SmartToy">ИИ-Ассистент</MudNavLink>
            <MudNavLink Href="/login" Icon="@Icons.Material.Filled.Logout" Color="Color.Error">Выйти</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="pt-16 pb-4 px-2">
        @Body
    </MudMainContent>
</MudLayout>
